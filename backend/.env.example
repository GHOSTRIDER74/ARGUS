# --- ARGUS backend environment variables ---
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (you manage the server yourself; run backend/app/database/schema.sql first)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://argus:changeme@localhost:5432/argus

# Set to true only for local SQLite development (tables auto-created).
# With PostgreSQL keep false and run schema.sql manually.
AUTO_CREATE_TABLES=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Where uploaded / generated / processed data files are stored
DATA_DIR=../data

# Upload limit in megabytes
MAX_UPLOAD_MB=100

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
